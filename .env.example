LINKEDIN_ACCESS_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-pro

# Benchmark candidates (optional, M5 pilot) — named so a specific model can
# be pinned for a one-off dispatch without touching OPENROUTER_IMAGE_MODEL.
OPENROUTER_IMAGE_MODEL_GPT_SUNBURST=openai/gpt-image-2.5-sunburst
OPENROUTER_IMAGE_MODEL_MAI_FLASH=microsoft/mai-image-2.6-flash
OPENROUTER_IMAGE_MODEL_MUSE=meta/muse-image
OPENROUTER_IMAGE_MODEL_GROK=x-ai/grok-imagine-image-2.0
OPENROUTER_IMAGE_MODEL_FLUX=black-forest-labs/flux.2-max
